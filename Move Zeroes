class Solution 
{
    public void moveZeroes(int[] nums) 
    {
        // int array nums move all 0s to the end of the array
        //without making a copy of the array
        //maintain order of all other elements 

        // two pointers left and right
        // left one to look for 0 and right to paste(swap but something nothing with the 0) them at the end of the array
        //but wait we would need to move numbers to the left one removing the 0
        

        int overHere = 0; //pointer to show wehre to write the current value

        for(int i = 0 ; i < nums.length ; i++)
        {
            if(nums[i] != 0)
            {
                nums[overHere] = nums[i];
                overHere++;
            }
        }

        // replace all numbers from overHere to the end with 0s 

        for(int j = overHere ; j < nums.length ;j++)
        {
            nums[j] = 0;
        }


        for(int n = 0 ; n < nums.length ;n++)
        {
            System.out.print(nums[n]);
        }




        
    }
}
